        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded (2xx)', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "",
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "",
                  "function pickToken(obj) {",
                  "  if (!obj || typeof obj !== 'object') return null;",
                  "  const direct = obj.token || obj.Token || obj.accessToken || obj.bearer_token;",
                  "  if (typeof direct === 'string' && direct.length) return direct;",
                  "  if (obj.data) {",
                  "    const nested = obj.data.token || obj.data.Token || obj.data.accessToken;",
                  "    if (typeof nested === 'string' && nested.length) return nested;",
                  "  }",
                  "  if (obj.result) {",
                  "    const nested2 = obj.result.token || obj.result.Token || obj.result.accessToken;",
                  "    if (typeof nested2 === 'string' && nested2.length) return nested2;",
                  "  }",
                  "  return null;",
                  "}",
                  "",
                  "const token = pickToken(json);",
                  "pm.test('Token present in response', function () {",
                  "  pm.expect(token, 'token').to.be.a('string').and.not.be.empty;",
                  "});",
                  "",
                  "if (token) {",
                  "  pm.environment.set('bearer_token', token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"collegeId\": {{collegeId}},\n  \"UniId\": 0,\n  \"isUgc\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/User/Login",
              "host": ["{{base_url}}"],
              "path": ["api", "User", "Login"]
            }
          },
          "response": []
        }
      ]
    },
