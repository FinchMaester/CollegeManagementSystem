# Copy to .env and set values. Never commit .env.
# Database
DB_HOSTNAME=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=a_final_college

# CodeIgniter encryption (long random string in production)
APP_ENCRYPTION_KEY=

# JWT signing secret for Authorization_token (min 32 random bytes recommended)
JWT_SECRET=

# Optional: override session files directory (absolute path on server)
# Leave unset to use application/cache/sessions
# SESSION_SAVE_PATH=

# HEMIS / UGC (optional overrides; admin DB settings still apply if these are empty)
HEMIS_MOCK=true
# Set to false on hosts that must call real UGC (staging/production).
# HEMIS_REMOTE_BASE_URL=https://hemisapi.ugcnepal.edu.np
# Prefer auto-login (leave bearer empty) instead of pasting tokens that expire:
# HEMIS_REMOTE_LOGIN_EMAIL=
# HEMIS_REMOTE_LOGIN_PASSWORD=
# UniId for /api/User/Login only — Postman college login uses 0 (not HEMIS_UNIVERSITY_ID):
# HEMIS_REMOTE_LOGIN_UNI_ID=0
# HEMIS_REMOTE_COLLEGE_ID=
# HEMIS_UNIVERSITY_ID=1
# Optional bootstrap token only (omit after auto-login saves to DB):
# HEMIS_REMOTE_BEARER_TOKEN=
# Force .env token to override DB (not recommended if using auto-login):
# HEMIS_ENV_TOKEN_OVERRIDES_DB=false
# HEMIS_LOCAL_MOCK_BASE_URL=
